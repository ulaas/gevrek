# gevrek's display manager: the login on the first console, and the
# session it opens on the second. See resources/dm/README.md.
[Unit]
Description=gevrek display manager
# The first console is the login's, not a text login's.
# (kmsconvt: the console program newer Fedoras have in getty's place.)
Conflicts=getty@tty1.service kmsconvt@tty1.service
After=getty@tty1.service kmsconvt@tty1.service systemd-user-sessions.service systemd-logind.service
# A boot splash is ended by the service itself, when the login is on the
# display (crates/dm/src/splash.rs), not by plymouth-quit.service, which
# would put the text console between the two. (As gdm's unit has it.)
Conflicts=plymouth-quit.service
After=plymouth-start.service plymouth-quit.service
# A login that does not come up gives the console back, and the splash
# is ended after all.
OnFailure=getty@tty1.service plymouth-quit.service

[Service]
ExecStart=/usr/bin/gevrek-dm
# How much it logs is gevrek's own choice (gevrek-logging); a drop-in
# with Environment=RUST_LOG=... says instead.
# It gives up by itself after three greeters that did not come up.
Restart=no

[Install]
Alias=display-manager.service
