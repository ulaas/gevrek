<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What macOS knows gevrek by: the permissions it is given
	     (Accessibility) are this id's, with the signature's team. -->
	<key>CFBundleIdentifier</key>
	<string>io.github.ulaas.gevrek</string>
	<key>CFBundleName</key>
	<string>gevrek</string>
	<key>CFBundleDisplayName</key>
	<string>gevrek</string>
	<key>CFBundleExecutable</key>
	<string>gevrek-wm</string>
	<key>CFBundleIconFile</key>
	<string>gevrek</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- A window manager has no Dock icon and no menu bar of its own. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Why the shell's control centre touches bluetooth (its radio and
	     the paired devices): macOS ends a program that does without
	     saying. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>gevrek's control centre shows bluetooth's devices, connects them and switches the radio.</string>
	<!-- macOS names the wifi's networks only to a program that may know
	     the location: gevrek uses it for nothing else. -->
	<key>NSLocationUsageDescription</key>
	<string>macOS names the wifi networks in reach only to a program that may know the location. gevrek uses it for that alone: its control centre lists the networks and joins them.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>macOS names the wifi networks in reach only to a program that may know the location. gevrek uses it for that alone: its control centre lists the networks and joins them.</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT licence</string>
</dict>
</plist>
